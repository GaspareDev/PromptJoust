# ==============================================================================
# PromptJoust - Centralized Environment Configuration Template
# Copy this file to .env and configure your desired API keys and model parameters.
# ==============================================================================

# --- Default Arena Arbitration Provider ---
# Options: gemini | claude | openai | groq | ollama
DEFAULT_LLM_PROVIDER=gemini

# --- Google Gemini Configuration ---
# API Key: Get from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic Claude Configuration ---
# API Key: Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022

# --- OpenAI Configuration ---
# API Key: Get from https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Groq Cloud Configuration ---
# API Key: Get from https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Local Ollama Configuration (100% Free & Offline) ---
# Host Endpoint (Default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Web Server Configuration ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
DEFAULT_TIMEOUT=30
